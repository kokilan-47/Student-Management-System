<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.nithuinstitueapp.controller.ProfileController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
    <Label styleClass="page-title" text="My Profile"/>
    <VBox maxWidth="420.0" spacing="14.0" styleClass="card">
        <GridPane hgap="16.0" vgap="10.0">
            <Label styleClass="stat-label" text="Username" GridPane.rowIndex="0"/>
            <Label fx:id="usernameLabel" styleClass="section-title" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label styleClass="stat-label" text="Role" GridPane.rowIndex="1"/>
            <Label fx:id="roleLabel" styleClass="section-title" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
        <Button fx:id="newUserBtn" onAction="#openNewUser" styleClass="btn-primary" text="Create New User"/>
        <Label styleClass="hint" text="Only Admin users can create new accounts."/>
    </VBox>
</VBox>
