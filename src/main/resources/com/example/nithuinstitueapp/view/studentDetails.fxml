<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" stylesheets="@../css/style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.nithuinstitueapp.controller.StudentDetailsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>
    <Label styleClass="page-title" text="Student Details"/>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="nameStView" onAction="#searchDetails" prefWidth="240.0" promptText="Search by name"/>
        <TextField fx:id="gradeStView" onAction="#searchDetails" prefWidth="120.0" promptText="Grade (optional)"/>
        <Button onAction="#searchDetails" styleClass="btn-primary" text="Search"/>
        <Button onAction="#resetSearch" styleClass="btn-secondary" text="Show All"/>
    </HBox>
    <Label styleClass="hint" text="Double-click a row to view, edit or delete the student."/>
    <TableView fx:id="studentTableView" onMouseClicked="#handleDoubleClick" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" prefWidth="50.0" text="ID"/>
            <TableColumn fx:id="nameCol" prefWidth="160.0" text="Name"/>
            <TableColumn fx:id="dobCol" prefWidth="100.0" text="Date of Birth"/>
            <TableColumn fx:id="gradeCol" prefWidth="60.0" text="Grade"/>
            <TableColumn fx:id="genderCol" prefWidth="70.0" text="Gender"/>
            <TableColumn fx:id="addressCol" prefWidth="180.0" text="Address"/>
            <TableColumn fx:id="contactCol" prefWidth="110.0" text="Phone"/>
            <TableColumn fx:id="emailCol" prefWidth="180.0" text="Email"/>
            <TableColumn fx:id="parentNameCol" prefWidth="160.0" text="Parent Name"/>
            <TableColumn fx:id="parentRelationCol" prefWidth="100.0" text="Relationship"/>
            <TableColumn fx:id="parentContactCol" prefWidth="120.0" text="Parent Contact"/>
        </columns>
    </TableView>
</VBox>
